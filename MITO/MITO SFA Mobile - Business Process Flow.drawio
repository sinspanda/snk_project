        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Profil Partner&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P04-PRF-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Dealer Owner mereview profil usaha, data legal, alamat, outlet, dan dokumen partner yang aktif.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Dealer Owner mereview profil usaha, data legal, alamat, outlet, dan dokumen partner yang aktif.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Ajukan Perubahan Profil&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P04-PRF-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Dealer Owner mengajukan perubahan data atau dokumen; data aktif tetap digunakan selama proses review.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Dealer Owner mengajukan perubahan data atau dokumen; data aktif tetap digunakan selama proses review.">
          <mxGeometry x="545" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Distribusikan Permintaan Review&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P04-PRF-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi kelengkapan dan mengarahkan permintaan kepada Internal Sales yang ditugaskan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi kelengkapan dan mengarahkan permintaan kepada Internal Sales yang ditugaskan.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Perubahan Profil&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P04-PRF-04 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Internal Sales menyetujui, menolak dengan alasan, atau meminta revisi perubahan profil partner.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Internal Sales menyetujui, menolak dengan alasan, atau meminta revisi perubahan profil partner.">
          <mxGeometry x="1035" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Terapkan Perubahan Profil&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P04-PRF-05 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menerapkan data yang disetujui sebagai profil aktif dan menyediakan hasil review kepada SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menerapkan data yang disetujui sebagai profil aktif dan menyediakan hasil review kepada SFA.">
