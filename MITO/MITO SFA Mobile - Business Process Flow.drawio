        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Informasi Dashboard&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-DSH-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan ringkasan visit, order, revenue, stock outlet, dan aktivitas sesuai role dan scope data pengguna.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan ringkasan visit, order, revenue, stock outlet, dan aktivitas sesuai role dan scope data pengguna.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Aktivitas Penjualan&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-DSH-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mereview aktual visit, order, dan revenue yang tersedia untuk memahami aktivitas penjualan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mereview aktual visit, order, dan revenue yang tersedia untuk memahami aktivitas penjualan.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Visit Conversion&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-DSH-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mereview completed visit dengan order, tanpa order, dan Visit-to-Order Conversion.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mereview completed visit dengan order, tanpa order, dan Visit-to-Order Conversion.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Prioritas Harian&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-WRK-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales mereview aktivitas hari ini dan pekerjaan tertunda untuk menentukan follow-up.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales mereview aktivitas hari ini dan pekerjaan tertunda untuk menentukan follow-up.">
          <mxGeometry x="1035" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Prioritas Stock Outlet&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-WRK-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mereview outlet dengan status Out of Stock, Low Stock, On Stock, atau Stock Opname Due.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mereview outlet dengan status Out of Stock, Low Stock, On Stock, atau Stock Opname Due.">
          <mxGeometry x="1280" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Jadwalkan Visit dari Alert&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-WRK-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales membuat jadwal visit dari kebutuhan follow-up stock; sistem tidak membuat visit otomatis.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales membuat jadwal visit dari kebutuhan follow-up stock; sistem tidak membuat visit otomatis.">
          <mxGeometry x="1525" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Integration Staging&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P02-INT-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Super Admin mereview transaksi Pending, Synced, dan Failed antara SFA dan CMS.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Super Admin mereview transaksi Pending, Synced, dan Failed antara SFA dan CMS.">
          <mxGeometry x="1770" y="663" width="210" height="112" as="geometry" />
