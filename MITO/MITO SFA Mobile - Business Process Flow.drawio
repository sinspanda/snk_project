        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Pilih Warehouse&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P07-PRD-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales menggunakan default warehouse customer/territory atau memilih warehouse lain jika memiliki kewenangan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales menggunakan default warehouse customer/territory atau memilih warehouse lain jika memiliki kewenangan.">
          <mxGeometry x="790" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Stock MITO&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P07-PRD-04 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna melihat stock per warehouse terpilih tanpa agregasi antar-warehouse.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna melihat stock per warehouse terpilih tanpa agregasi antar-warehouse.">
