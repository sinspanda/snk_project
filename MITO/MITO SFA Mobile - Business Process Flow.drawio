          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat Movement IN&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P11-STK-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS membuat movement IN dan mencegah konfirmasi ganda untuk reference penerimaan yang sama.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS membuat movement IN dan mencegah konfirmasi ganda untuk reference penerimaan yang sama.">
          <mxGeometry x="790" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat Sell-Out&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P11-STK-04 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS membuat movement OUT ketika Warranty Activation/Sell-Out disetujui. Reward Claim tidak membuat OUT kedua.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS membuat movement OUT ketika Warranty Activation/Sell-Out disetujui. Reward Claim tidak membuat OUT kedua.">
          <mxGeometry x="1035" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Laksanakan Stock Opname&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P11-STK-05 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna membandingkan System On Hand dengan Counted Quantity pada outlet.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna membandingkan System On Hand dengan Counted Quantity pada outlet.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat Adjustment Stock&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P11-STK-06 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS membuat Adjustment IN atau OUT sebesar selisih sehingga On Hand sama dengan Counted Quantity tanpa menghapus riwayat movement.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS membuat Adjustment IN atau OUT sebesar selisih sehingga On Hand sama dengan Counted Quantity tanpa menghapus riwayat movement.">
          <mxGeometry x="1525" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Tindak Lanjut Stock Priority&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P11-STK-07 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales menjadwalkan visit dari alert Low Stock, Out of Stock, atau Stock Opname Due bila diperlukan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales menjadwalkan visit dari alert Low Stock, Out of Stock, atau Stock Opname Due bila diperlukan.">
