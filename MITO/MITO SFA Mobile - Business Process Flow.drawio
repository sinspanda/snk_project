        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Dashboard menyediakan ringkasan aktivitas dan prioritas kerja. Implementasinya ditempatkan sebagai prioritas rendah pada draft awal." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
