        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Putuskan Reschedule&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P05-RSC-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales Manager menyetujui atau menolak reschedule. Riwayat pengajuan tetap tercatat pada detail jadwal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales Manager menyetujui atau menolak reschedule. Riwayat pengajuan tetap tercatat pada detail jadwal.">
