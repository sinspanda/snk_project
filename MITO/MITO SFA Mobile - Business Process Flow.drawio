        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Distribusikan Approval Reschedule&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P05-RSC-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menentukan approver berdasarkan approval matrix dan menyediakan permintaan pada approval inbox.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menentukan approver berdasarkan approval matrix dan menyediakan permintaan pada approval inbox.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
