        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Laksanakan Visit&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P06-VEX-03 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna melakukan aktivitas penjualan, follow-up, pengecekan outlet, atau komunikasi dengan customer.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna melakukan aktivitas penjualan, follow-up, pengecekan outlet, atau komunikasi dengan customer.">
