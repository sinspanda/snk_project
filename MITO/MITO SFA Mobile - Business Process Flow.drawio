        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Ajukan Reward Claim&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P15-CLM-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Partner memilih IMEI dengan warranty Active dan status reward Eligible lalu mengonfirmasi claim tanpa attachment tambahan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Partner memilih IMEI dengan warranty Active dan status reward Eligible lalu mengonfirmasi claim tanpa attachment tambahan.">
          <mxGeometry x="790" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi Reward Claim&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P15-CLM-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memastikan warranty Active dan IMEI belum pernah diklaim. Satu IMEI hanya dapat memiliki satu Reward Claim.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memastikan warranty Active dan IMEI belum pernah diklaim. Satu IMEI hanya dapat memiliki satu Reward Claim.">
          <mxGeometry x="1035" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat &amp;amp; Kunci Claim&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P15-CLM-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS mencatat claim yang valid, menguncinya dari klaim ganda, dan menyiapkan kebutuhan Vendor Bill bila reward bersifat payable.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS mencatat claim yang valid, menguncinya dari klaim ganda, dan menyiapkan kebutuhan Vendor Bill bila reward bersifat payable.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Status Claim&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P15-CLM-04 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Partner memantau status Eligible, Pending Sync, Claimed, Processing, dan Completed pada claim yang sama.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Partner memantau status Eligible, Pending Sync, Claimed, Processing, dan Completed pada claim yang sama.">
