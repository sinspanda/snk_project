        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Jadwal Visit&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P05-VPL-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan jadwal visit berdasarkan assignment Sales dan customer/outlet.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan jadwal visit berdasarkan assignment Sales dan customer/outlet.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Agenda Visit&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P05-VPL-02 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales mereview agenda harian melalui date navigator dan memilih visit yang perlu dilakukan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales mereview agenda harian melalui date navigator dan memilih visit yang perlu dilakukan.">
