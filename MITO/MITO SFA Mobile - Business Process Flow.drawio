        <mxCell id="g1-lane-label-2" value="Staff" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1094" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g1-act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Daftarkan Staff&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-STF-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner mendaftarkan data Staff dan menentukan role. Hak akses mengikuti konfigurasi role yang telah ditetapkan pada SFA dan CMS.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner mendaftarkan data Staff dan menentukan role. Hak akses mengikuti konfigurasi role yang telah ditetapkan pada SFA dan CMS.">
          <mxGeometry x="300" y="787" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g1-act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi dan Hubungkan Staff&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-STF-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi kewenangan Owner, memeriksa duplikasi username atau email, lalu membuat User Staff yang terhubung dengan Customer milik Owner.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi kewenangan Owner, memeriksa duplikasi username atau email, lalu membuat User Staff yang terhubung dengan Customer milik Owner.">
          <mxGeometry x="545" y="952" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g1-act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktifkan Staff&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-STF-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner mengaktifkan atau menonaktifkan Staff tanpa approval pengguna internal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner mengaktifkan atau menonaktifkan Staff tanpa approval pengguna internal.">
          <mxGeometry x="790" y="787" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g1-act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktivasi Akses Staff&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-STF-04 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Staff membuat password dan mengaktifkan akses pada organisasi serta role yang telah ditentukan Owner.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Staff membuat password dan mengaktifkan akses pada organisasi serta role yang telah ditentukan Owner.">
          <mxGeometry x="1035" y="1117" width="210" height="112" as="geometry" />
        </mxCell>
