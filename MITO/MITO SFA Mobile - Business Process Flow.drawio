        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Mulai Quotation&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P09-QT-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Partner memilih produk dan quantity melalui konsep catalog-cart yang sama dengan Sales Order internal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Partner memilih produk dan quantity melalui konsep catalog-cart yang sama dengan Sales Order internal.">
