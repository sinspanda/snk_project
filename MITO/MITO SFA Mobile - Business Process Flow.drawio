        <mxCell id="title" value="P17 - Mode Offline &amp;amp; Sinkronisasi" style="shape=rect;rounded=0;fillColor=#111827;strokeColor=#111827;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1990" height="55" as="geometry" />
