  <diagram id="081dd9fed9105d7aa1c1" name="P01B - Registrasi &amp; Aktivasi Pengguna Eksternal">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2725" pageHeight="1345" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="P01B - Registrasi &amp;amp; Aktivasi Pengguna Eksternal" style="shape=rect;rounded=0;fillColor=#111827;strokeColor=#111827;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2725" height="55" as="geometry" />
        </mxCell>
        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Owner melakukan self-registration yang menghasilkan Customer dan User Owner terkait. Setelah review internal, Customer dan User diaktifkan. Staff didaftarkan oleh Owner sebagai User tambahan pada Customer yang sudah ada tanpa approval internal." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="25" y="62" width="2675" height="65" as="geometry" />
        </mxCell>
        <mxCell id="g0-header" value="Registrasi Owner" style="shape=rect;rounded=0;fillColor=#1F4E78;strokeColor=#17365D;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="2685" height="34" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-bg-0" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="189" width="2685" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-label-0" value="Owner" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="189" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-bg-1" value="" style="shape=rect;rounded=0;fillColor=#EEF2F7;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="354" width="2685" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-label-1" value="CMS" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="354" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-bg-2" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="519" width="2685" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-lane-label-2" value="Salesman / GTM / Kacab" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="519" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Mulai Self-Registration&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner memulai registrasi mandiri sebagai calon Customer sekaligus pengguna utama pada SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner memulai registrasi mandiri sebagai calon Customer sekaligus pengguna utama pada SFA.">
          <mxGeometry x="300" y="212" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Lengkapi Data Customer dan User&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner mengisi informasi usaha, alamat, segmentasi, dokumen pendukung, serta data akun Owner yang akan dihubungkan dengan Customer. OTP belum termasuk scope.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner mengisi informasi usaha, alamat, segmentasi, dokumen pendukung, serta data akun Owner yang akan dihubungkan dengan Customer. OTP belum termasuk scope.">
          <mxGeometry x="545" y="212" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Kirim Self-Registration&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner memeriksa kelengkapan data kemudian mengirim registrasi Customer dan User untuk diproses.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner memeriksa kelengkapan data kemudian mengirim registrasi Customer dan User untuk diproses.">
          <mxGeometry x="790" y="212" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi Data Registrasi&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-04 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi data wajib serta memeriksa duplikasi Customer, username, dan alamat email.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi data wajib serta memeriksa duplikasi Customer, username, dan alamat email.">
          <mxGeometry x="1035" y="377" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Buat Customer dan User Terkait&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-05 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS membuat satu record Customer dan satu User Owner yang saling terhubung dengan status menunggu review internal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS membuat satu record Customer dan satu User Owner yang saling terhubung dengan status menunggu review internal.">
          <mxGeometry x="1280" y="377" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Registrasi Customer&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-06 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna internal mereview informasi usaha, dokumen, dan User Owner kemudian menyetujui registrasi atau meminta revisi.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna internal mereview informasi usaha, dokumen, dan User Owner kemudian menyetujui registrasi atau meminta revisi.">
          <mxGeometry x="1525" y="542" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Revisi Data Registrasi&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-07 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner memperbaiki data Customer atau User sesuai catatan review lalu mengirim ulang registrasi yang sama.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner memperbaiki data Customer atau User sesuai catatan review lalu mengirim ulang registrasi yang sama.">
          <mxGeometry x="1770" y="212" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-7" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktifkan Customer dan User&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-08 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Setelah disetujui, CMS mengaktifkan Customer beserta User Owner terkait dan meneruskan master Customer ke Odoo melalui integration staging.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Setelah disetujui, CMS mengaktifkan Customer beserta User Owner terkait dan meneruskan master Customer ke Odoo melalui integration staging.">
          <mxGeometry x="2015" y="377" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g0-act-8" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktivasi Akses Owner&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-EXT-09 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner membuat password dan mengaktifkan akses ke SFA sebagai User utama dari Customer yang telah disetujui.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner membuat password dan mengaktifkan akses ke SFA sebagai User utama dari Customer yang telah disetujui.">
          <mxGeometry x="2260" y="212" width="210" height="112" as="geometry" />
