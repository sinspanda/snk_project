          <mxGeometry x="20" y="310" width="1950" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-1" value="User" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-2" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="1950" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-2" value="Super Admin" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Data Offline&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P17-OFF-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan data yang diizinkan untuk disimpan sebagai cache lokal sesuai role dan assignment pengguna.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan data yang diizinkan untuk disimpan sebagai cache lokal sesuai role dan assignment pengguna.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Laksanakan Aktivitas Offline&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P17-OFF-02 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna melaksanakan visit atau aktivitas lapangan ketika koneksi tidak tersedia.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna melaksanakan visit atau aktivitas lapangan ketika koneksi tidak tersedia.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Konfirmasi Transaksi Offline&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P17-OFF-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna dapat mengonfirmasi transaksi yang didukung sehingga tersimpan sebagai Pending Sync dengan local transaction ID unik.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna dapat mengonfirmasi transaksi yang didukung sehingga tersimpan sebagai Pending Sync dengan local transaction ID unik.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sinkronkan Transaksi&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P17-SYN-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menerima transaksi Pending, melakukan validasi akhir, dan mengembalikan status Synced atau Failed.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menerima transaksi Pending, melakukan validasi akhir, dan mengembalikan status Synced atau Failed.">
          <mxGeometry x="1035" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Tindak Lanjut Sync Failed&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P17-SYN-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna melihat alasan kegagalan lalu melakukan Retry atau Edit &amp;amp; Resubmit sehingga transaksi kembali Pending.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna melihat alasan kegagalan lalu melakukan Retry atau Edit &amp; Resubmit sehingga transaksi kembali Pending.">
