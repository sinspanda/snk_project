        <mxCell id="lane-label-2" value="Sales / Sales Manager" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Mulai Sales Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales memilih satu Customer dan memulai order, termasuk dari detail Visit bila relevan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales memilih satu Customer dan memulai order, termasuk dari detail Visit bila relevan.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Susun Produk Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales memilih beberapa produk, menentukan quantity, dan mereview cart sebagai satu Sales Order.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales memilih beberapa produk, menentukan quantity, dan mereview cart sebagai satu Sales Order.">
          <mxGeometry x="545" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Harga, Discount &amp;amp; Tax&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan harga dan tax; Sales dapat mengisi line discount dalam batas role yang diizinkan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan harga dan tax; Sales dapat mengisi line discount dalam batas role yang diizinkan.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Simpan Draft Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-04 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales menyimpan order yang belum final dan dapat mengubah atau membatalkannya sesuai akses.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales menyimpan order yang belum final dan dapat mengubah atau membatalkannya sesuai akses.">
          <mxGeometry x="1035" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Konfirmasi Sales Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-05 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales mengonfirmasi cart sebagai satu Sales Order untuk diproses lebih lanjut.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales mengonfirmasi cart sebagai satu Sales Order untuk diproses lebih lanjut.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi &amp;amp; Proses Sales Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-06 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi customer, produk, stock, harga, discount, tax, dan approval sebelum meneruskan transaksi ke Odoo.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi customer, produk, stock, harga, discount, tax, dan approval sebelum meneruskan transaksi ke Odoo.">
          <mxGeometry x="1525" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Status Order&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P08-SO-07 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mereview status, timeline, approval, atau alasan rejection pada Sales Order yang sama.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mereview status, timeline, approval, atau alasan rejection pada Sales Order yang sama.">
          <mxGeometry x="1770" y="498" width="210" height="112" as="geometry" />
