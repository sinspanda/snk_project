        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Scan Produk&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P07-PRD-05 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna dapat mencari produk melalui barcode scanner dengan pencarian manual sebagai fallback.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna dapat mencari produk melalui barcode scanner dengan pencarian manual sebagai fallback.">
