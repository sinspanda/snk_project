        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi IMEI &amp;amp; Warranty&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P13-WAR-04 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi format, produk, duplicate IMEI/Sell-Out, warranty eligibility, reward eligibility, dan ketersediaan reward.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi format, produk, duplicate IMEI/Sell-Out, warranty eligibility, reward eligibility, dan ketersediaan reward.">
          <mxGeometry x="1035" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Warranty Activation&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P13-WAR-05 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Approver menyetujui atau menolak aktivasi dan wajib memberikan alasan jika ditolak.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Approver menyetujui atau menolak aktivasi dan wajib memberikan alasan jika ditolak.">
