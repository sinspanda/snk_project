        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Flow ini digunakan bersama oleh seluruh role internal dan eksternal setelah akun aktif, mencakup login, akses offline, perubahan password, dan logout." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="25" y="62" width="2430" height="65" as="geometry" />
