  <diagram id="9e49822abe965e16b07c" name="P12 - Penagihan Order &amp; Collection">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="P12 - Penagihan Order &amp;amp; Collection" style="shape=rect;rounded=0;fillColor=#111827;strokeColor=#111827;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; SFA mendukung penyampaian invoice dan pencatatan collection tanpa scope accounting journal. Setelah collection dikonfirmasi, status SFA menjadi Paid." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="25" y="62" width="1750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-0" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="1760" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-0" value="CMS" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="155" height="157" as="geometry" />
