          <mxGeometry x="20" y="310" width="1760" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-1" value="Sales / SPG" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Invoice&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P12-COL-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan order yang siap invoice, nomor invoice, status pembayaran, due date, dan PDF invoice kepada SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan order yang siap invoice, nomor invoice, status pembayaran, due date, dan PDF invoice kepada SFA.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review &amp;amp; Sampaikan Invoice&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P12-COL-02 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mereview, mengunduh, mencetak, atau membagikan PDF invoice kepada customer.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mereview, mengunduh, mencetak, atau membagikan PDF invoice kepada customer.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Lakukan Collection&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P12-COL-03 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Sales atau SPG melakukan penagihan dan menerima informasi atau bukti pembayaran dari customer.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Sales atau SPG melakukan penagihan dan menerima informasi atau bukti pembayaran dari customer.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat Collection&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P12-COL-04 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mencatat invoice, tanggal, jumlah, metode, reference, dan attachment wajib; transaksi dapat dikonfirmasi offline.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mencatat invoice, tanggal, jumlah, metode, reference, dan attachment wajib; transaksi dapat dikonfirmasi offline.">
          <mxGeometry x="1035" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Catat Pembayaran&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P12-COL-05 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS mencatat payment, menandai invoice Paid untuk SFA, dan mengelola sinkronisasi pembayaran ke Odoo.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS mencatat payment, menandai invoice Paid untuk SFA, dan mengelola sinkronisasi pembayaran ke Odoo.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Mulai" style="ellipse;aspect=fixed;fillColor=#A9D18E;strokeColor=#548235;strokeWidth=2;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F3B13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="195" y="195" width="70" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Selesai" style="ellipse;aspect=fixed;fillColor=#F4B6C2;strokeColor=#C00000;strokeWidth=2;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#7F0000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1525" y="195" width="70" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="act-0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act-0" target="act-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act-1" target="act-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act-2" target="act-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act-3" target="act-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="act-4" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Catatan proses&lt;/b&gt;&lt;br&gt;- Status Pending Odoo Sync, Synced, atau Sync Failed hanya terlihat di CMS." style="shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;spacing=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#5B4700;" vertex="1" parent="1">
          <mxGeometry x="180" y="485" width="1580" height="75" as="geometry" />
