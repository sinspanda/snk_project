        <mxCell id="title" value="P03 - Registrasi Customer" style="shape=rect;rounded=0;fillColor=#111827;strokeColor=#111827;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1990" height="55" as="geometry" />
        </mxCell>
        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Salesman, GTM, atau SPG dapat mendaftarkan Customer beserta User Owner terkait. CMS membuat dan menghubungkan kedua record, kemudian hanya master Customer yang diteruskan ke Odoo." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="25" y="62" width="1940" height="65" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-0" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="1950" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-0" value="Salesman / GTM / SPG" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-1" value="" style="shape=rect;rounded=0;fillColor=#EEF2F7;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="1950" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-1" value="CMS" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-2" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="1950" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-2" value="Owner" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Daftarkan Customer dan User&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna internal mendaftarkan informasi Customer, segmentasi bisnis seperti Retail atau Pareto, Salesperson yang bertanggung jawab, dan data User Owner utama.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna internal mendaftarkan informasi Customer, segmentasi bisnis seperti Retail atau Pareto, Salesperson yang bertanggung jawab, dan data User Owner utama.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi Data Customer dan User&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi data wajib serta memeriksa duplikasi Customer, username, dan alamat email pada saat registrasi.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi data wajib serta memeriksa duplikasi Customer, username, dan alamat email pada saat registrasi.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Buat Customer dan User Terkait&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS membuat satu record Customer dan satu User Owner yang saling terhubung, termasuk hubungan dengan Salesperson dan segmentasi yang dipilih.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS membuat satu record Customer dan satu User Owner yang saling terhubung, termasuk hubungan dengan Salesperson dan segmentasi yang dipilih.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Integrasikan Master Customer&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-04 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS meneruskan master Customer ke Odoo melalui integration staging. Master User tetap dikelola pada CMS dan SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS meneruskan master Customer ke Odoo melalui integration staging. Master User tetap dikelola pada CMS dan SFA.">
          <mxGeometry x="1035" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Informasi Aktivasi&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-05 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan informasi aktivasi kepada User Owner yang didaftarkan oleh pengguna internal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan informasi aktivasi kepada User Owner yang didaftarkan oleh pengguna internal.">
          <mxGeometry x="1280" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktivasi Akses Customer&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P03-CUS-06 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Owner membuat password dan mengaktifkan akses ke SFA sebagai User utama dari Customer terkait.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Owner membuat password dan mengaktifkan akses ke SFA sebagai User utama dari Customer terkait.">
          <mxGeometry x="1525" y="498" width="210" height="112" as="geometry" />
        </mxCell>
