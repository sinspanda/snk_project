        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Database mobile berfungsi sebagai cache dan antrean transaksi, bukan source of truth. Final validation tetap dilakukan CMS." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
