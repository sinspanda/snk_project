        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Approval Assignment&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P18-APR-01 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menentukan approver dan level berdasarkan approval matrix yang tersimpan di CMS.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menentukan approver dan level berdasarkan approval matrix yang tersimpan di CMS.">
