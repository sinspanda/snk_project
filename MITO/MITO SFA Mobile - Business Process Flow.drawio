        <mxCell id="lane-label-2" value="SFA Mobile" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Login ke SFA&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-01 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna memasukkan username atau email terdaftar dan password untuk mengakses SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna memasukkan username atau email terdaftar dan password untuk mengakses SFA.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Autentikasi Pengguna&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi credential, status akun, role, dan organisasi pengguna.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi credential, status akun, role, dan organisasi pengguna.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Hak Akses&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-03 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan role, menu, dan assignment customer, dealer, outlet, atau territory kepada SFA.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan role, menu, dan assignment customer, dealer, outlet, atau territory kepada SFA.">
          <mxGeometry x="790" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Siapkan Akses Mobile&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-04 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;SFA menampilkan dashboard berbasis role dan menyiapkan data yang diizinkan untuk kebutuhan offline.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="SFA menampilkan dashboard berbasis role dan menyiapkan data yang diizinkan untuk kebutuhan offline.">
          <mxGeometry x="1035" y="498" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Akses SFA Offline&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-05 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna dapat menggunakan sesi lokal yang masih valid; login pertama dan autentikasi sesi kedaluwarsa wajib dilakukan online.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna dapat menggunakan sesi lokal yang masih valid; login pertama dan autentikasi sesi kedaluwarsa wajib dilakukan online.">
          <mxGeometry x="1280" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Ubah Password&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-06 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mengajukan perubahan password dengan mengonfirmasi password saat ini dan memasukkan password baru sesuai kebijakan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mengajukan perubahan password dengan mengonfirmasi password saat ini dan memasukkan password baru sesuai kebijakan.">
          <mxGeometry x="1525" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Perbarui Password&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-07 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS memvalidasi permintaan dan memperbarui credential untuk akses berikutnya.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS memvalidasi permintaan dan memperbarui credential untuk akses berikutnya.">
          <mxGeometry x="1770" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-7" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Logout dari SFA&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-LOG-08 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mengakhiri sesi aktif sehingga akun harus login kembali untuk mengakses aplikasi.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mengakhiri sesi aktif sehingga akun harus login kembali untuk mengakses aplikasi.">
