        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Pilih IMEI&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P13-WAR-01 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna memindai IMEI atau memasukkannya secara manual sebagai fallback.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna memindai IMEI atau memasukkannya secara manual sebagai fallback.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Lengkapi Aktivasi Warranty&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P13-WAR-02 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna memilih produk, tanggal Sell-Out, data minimum pemilik warranty, attachment, dan reward yang eligible.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna memilih produk, tanggal Sell-Out, data minimum pemilik warranty, attachment, dan reward yang eligible.">
          <mxGeometry x="545" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Konfirmasi Warranty Activation&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P13-WAR-03 | Customization&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mengonfirmasi aktivasi; konfirmasi offline menghasilkan status Pending Sync.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F4B6C2;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mengonfirmasi aktivasi; konfirmasi offline menghasilkan status Pending Sync.">
