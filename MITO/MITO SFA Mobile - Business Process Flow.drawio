        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Review Katalog Produk&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P07-PRD-02 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna mencari dan mereview produk yang dapat dijual sesuai customer atau partner terpilih.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna mencari dan mereview produk yang dapat dijual sesuai customer atau partner terpilih.">
