  <diagram id="635ae1509f77507c8844" name="P01A - Registrasi &amp; Aktivasi Pengguna Internal">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="P01A - Registrasi &amp;amp; Aktivasi Pengguna Internal" style="shape=rect;rounded=0;fillColor=#111827;strokeColor=#111827;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="purpose" value="&lt;b&gt;Deskripsi Proses:&lt;/b&gt; Registrasi internal digunakan untuk membuat akun Salesman, GTM, Kacab, dan SPG. Akun didaftarkan oleh Super Admin dan tidak menggunakan self-registration." style="shape=rect;rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="25" y="62" width="1750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-0" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="1760" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-0" value="Super Admin" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="145" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-1" value="" style="shape=rect;rounded=0;fillColor=#EEF2F7;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="1760" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-1" value="CMS" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-bg-2" value="" style="shape=rect;rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="1760" height="157" as="geometry" />
        </mxCell>
        <mxCell id="lane-label-2" value="Salesman / GTM / Kacab / SPG" style="shape=rect;rounded=0;fillColor=#475569;strokeColor=#334155;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="155" height="157" as="geometry" />
        </mxCell>
        <mxCell id="act-0" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Daftarkan Pengguna Internal&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-INT-01 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Super Admin membuat akun dan memilih salah satu role internal: Salesman, GTM, Kacab, atau SPG, termasuk assignment customer, outlet, atau territory bila diperlukan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Super Admin membuat akun dan memilih salah satu role internal: Salesman, GTM, Kacab, atau SPG, termasuk assignment customer, outlet, atau territory bila diperlukan.">
          <mxGeometry x="300" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Validasi Data Pengguna&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-INT-02 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pada saat input, CMS memeriksa apakah username atau alamat email telah terdaftar.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pada saat input, CMS memeriksa apakah username atau alamat email telah terdaftar.">
          <mxGeometry x="545" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktifkan Akun Internal&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-INT-03 | Manual&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Super Admin mengaktifkan akun internal yang telah valid dan memastikan role pengguna telah sesuai.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#BDD7EE;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Super Admin mengaktifkan akun internal yang telah valid dan memastikan role pengguna telah sesuai.">
          <mxGeometry x="790" y="168" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Sediakan Informasi Aktivasi&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-INT-04 | Integration&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;CMS menyediakan informasi aktivasi serta instruksi pembuatan password kepada pengguna internal.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#F8CBAD;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="CMS menyediakan informasi aktivasi serta instruksi pembuatan password kepada pengguna internal.">
          <mxGeometry x="1035" y="333" width="210" height="112" as="geometry" />
        </mxCell>
        <mxCell id="act-4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Aktivasi Akses Internal&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;color:#475569'&gt;P01-INT-05 | Standard&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left;font-size:10px'&gt;Pengguna internal membuat password dan mengaktifkan akses sesuai role yang telah ditentukan.&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#64748B;strokeWidth=1.5;spacing=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1" tooltip="Pengguna internal membuat password dan mengaktifkan akses sesuai role yang telah ditentukan.">
